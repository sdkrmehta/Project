<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
	<div class="col-8 offset-2">
		<br />

		<h3>Create a new listings</h3>
		<form
			method="POST"
			action="/listings"
			novalidate
			class="needs-validation"
			enctype="multipart/form-data"
		>
			<div class="mb-3">
				<label for="title" class="form-label">Title</label>
				<input
					name="listing[title]"
					placeholder="Add a Title"
					type="text"
					class="form-control"
					required
				/>
				<div class="invalid-feedback">
					*Please add a title for the listing
				</div>
			</div>
			<div class="mb-3">
				<label for="description" class="form-label">Description</label>
				<textarea
					name="listing[description]"
					placeholder="Enter Description"
					type="text"
					class="form-control"
					required
				></textarea>
				<div class="invalid-feedback">
					*Please provide a description.
				</div>
			</div>

			<div class="mb-3">
				<label for="image" class="form-label"
					>Upload Listing Image</label
				>
				<input
					name="listing[image]"
					type="file"
					class="form-control"
					required
				/>
			</div>

			<div class="row">
				<div class="mb-3 col-md-4">
					<label for="price" class="form-label">Price</label>

					<input
						name="listing[price]"
						placeholder="Enter Price"
						type="number"
						class="form-control"
						required
					/>
					<div class="invalid-feedback">
						*Enter a price for your listing.
					</div>
				</div>
				<div class="mb-3 col-md-8">
					<label for="country" class="form-label">Country</label>

					<input
						name="listing[country]"
						placeholder="India"
						type="text"
						class="form-control"
						required
					/>
					<div class="invalid-feedback">
						*Please add the country name.
					</div>
				</div>
			</div>

			<div class="mb-3">
				<label for="location" class="form-label">Location</label>

				<input
					name="listing[location]"
					placeholder="Enter Location"
					type="text"
					class="form-control"
					required
				/>
				<div class="invalid-feedback">*Please add the location.</div>
			</div>
			<br />
			<button class="btn btn-dark add-btn">ADD</button>
		</form>
	</div>
</div>
